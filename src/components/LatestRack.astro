---
import Strip from './Strip.astro';
import type { Strip as StripData } from '../lib/strips';

interface Props {
  strips: StripData[];
  linked?: boolean;
}

const { strips, linked = true } = Astro.props;
---

<section class="latest" aria-labelledby="latest-heading">
  <div class="section-head">
    <h2 id="latest-heading">Latest filed</h2>
    <a class="section-head__link" href="/blog/">Every article</a>
  </div>

  <ol class="rack" role="list">
    {
      strips.map((strip, i) => (
        <li>
          <Strip strip={strip} inked={i === 0} linked={linked} />
        </li>
      ))
    }
  </ol>
</section>

<style>
  .rack {
    display: grid;
    gap: 3px;
    padding: 3px;
    list-style: none;
    background: var(--holder);
    border: 1px solid var(--holder-dark);
  }
</style>
