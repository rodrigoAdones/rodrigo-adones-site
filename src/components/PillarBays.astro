---
import Strip from './Strip.astro';
import type { Bay } from '../lib/strips';

interface Props {
  bays: Bay[];
  /** Holder slots per bay; unfilled slots stay visible as empty holders. */
  perBay?: number;
  linked?: boolean;
}

const { bays, perBay = 3, linked = true } = Astro.props;
---

<section class="bays" aria-labelledby="bays-heading">
  <div class="section-head">
    <h2 id="bays-heading">By pillar</h2>
    <p class="section-head__meta">Every post is filed under one of four pillars.</p>
  </div>

  <div class="bays__grid">
    {
      bays.map((bay) => (
        <section
          class="bay"
          id={`bay-${bay.pillar.id}`}
          aria-labelledby={`bay-${bay.pillar.id}-name`}
          style={`--strip: var(--strip-${bay.pillar.id})`}
        >
          <header class="bay__plate">
            <span class="bay__code">{bay.pillar.code}</span>
            <h3 class="bay__name" id={`bay-${bay.pillar.id}-name`}>
              <a href={bay.pillar.href}>{bay.pillar.name}</a>
            </h3>
            <p class="bay__count">
              {bay.strips.length} {bay.strips.length === 1 ? 'strip' : 'strips'}
            </p>
          </header>

          <ol class="bay__rack" role="list">
            {bay.strips.slice(0, perBay).map((strip) => (
              <li>
                <Strip strip={strip} variant="compact" headingLevel="h4" linked={linked} />
              </li>
            ))}
            {Array.from({ length: Math.max(0, perBay - bay.strips.length) }, (_, i) => (
              <li class="bay__slot" aria-hidden={bay.strips.length > 0 || i > 0 ? 'true' : undefined}>
                {bay.strips.length === 0 && i === 0 && 'No posts filed under this pillar yet.'}
              </li>
            ))}
          </ol>

          {bay.strips.length > perBay && (
            <a class="bay__more" href={bay.pillar.href}>
              All {bay.strips.length} in {bay.pillar.name}
            </a>
          )}
        </section>
      ))
    }
  </div>
</section>

<style>
  .bays__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .bay {
    display: grid;
    grid-template-rows: auto 1fr auto;
    align-content: start;
    scroll-margin-top: var(--space-5);
  }

  .bay__plate {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3);
    background: var(--paper);
    border: 1px solid var(--holder-dark);
    border-bottom: 0;
  }

  .bay__code {
    padding: var(--space-1) var(--space-2);
    background: var(--strip);
    border: 1px solid var(--rule);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .bay__name {
    font-size: 1.125rem;
    line-height: 1.2;
  }

  .bay__count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
  }

  .bay__name a {
    text-decoration-color: rgb(20 20 20 / 0.5);
  }

  .bay__name a:hover {
    text-decoration-color: currentColor;
  }

  /* The holder field: ruled slots on the bay board, strips racked into them. */
  .bay__rack {
    display: grid;
    grid-auto-rows: minmax(3.5rem, auto);
    gap: 3px;
    padding: 3px;
    list-style: none;
    background: var(--holder);
    border: 1px solid var(--holder-dark);
  }

  .bay__slot {
    display: grid;
    place-items: center;
    padding: var(--space-2) var(--space-4);
    background:
      repeating-linear-gradient(
        180deg,
        transparent 0 0.875rem,
        rgb(20 20 20 / 0.1) 0.875rem calc(0.875rem + 1px)
      ),
      var(--board-deep);
    color: var(--ink-soft);
    font-size: 0.875rem;
    text-align: center;
  }

  .bay__more {
    justify-self: start;
    margin-top: var(--space-3);
    font-weight: 700;
    font-size: 0.9375rem;
  }

  @media (max-width: 72rem) {
    .bays__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
