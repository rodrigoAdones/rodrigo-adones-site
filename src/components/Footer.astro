---
const external = [
  { href: 'https://linkedin.com/in/rodrigo-adones-vicencio', label: 'LinkedIn' },
  { href: 'https://github.com/rodrigoAdones', label: 'GitHub' },
  { href: 'https://github.com/rodrigoAdones/personal-site', label: 'Source' },
];
---

<footer class="footer frame" lang="en">
  <div class="footer__inner inner">
    <p class="footer__name">Rodrigo Adones</p>
    <ul class="footer__links">
      {
        external.map((link) => (
          <li>
            <a href={link.href} target="_blank" rel="noopener noreferrer">
              {link.label}
              <span class="visually-hidden">(opens in a new tab)</span>
            </a>
          </li>
        ))
      }
      <li>
        <a href="/rss.xml">RSS</a>
      </li>
    </ul>
  </div>
</footer>

<style>
  .footer {
    padding-block: var(--space-6) var(--space-7);
    border-top: 1px solid var(--rule);
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3) var(--space-6);
  }

  .footer__name {
    font-family: var(--font-serif);
    font-weight: 600;
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .footer__links a {
    color: var(--forest);
    font-weight: 500;
    text-decoration: none;
  }

  .footer__links a:hover {
    text-decoration: underline;
  }
</style>
