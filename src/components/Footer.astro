---
const links = [
  { href: 'https://linkedin.com/in/rodrigo-adones-vicencio', label: 'LinkedIn' },
  { href: 'https://github.com/rodrigoAdones', label: 'GitHub' },
];
---

<footer class="footer" lang="en">
  <p class="footer__name">Rodrigo Adones</p>
  <ul class="footer__links">
    {
      links.map((link) => (
        <li>
          <a href={link.href} target="_blank" rel="noopener noreferrer">
            {link.label}
            <span class="visually-hidden">(opens in a new tab)</span>
            <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true">
              <path d="M4 2h6v6M10 2 2.5 9.5" fill="none" stroke="currentColor" stroke-width="1.5" />
            </svg>
          </a>
        </li>
      ))
    }
  </ul>
</footer>

<style>
  .footer {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3) var(--space-6);
    padding-top: var(--space-5);
    border-top: 2px solid var(--holder);
  }

  .footer__name {
    font-weight: 700;
  }

  .footer__links {
    display: flex;
    gap: var(--space-5);
    padding: 0;
    list-style: none;
  }

  .footer__links a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-weight: 700;
  }

</style>
