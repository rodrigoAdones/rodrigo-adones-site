---
import { PILLARS } from '../lib/home';
import { IS_PLACEHOLDER, role, thesis } from '../data/intro';
---

<section class="intro inner">
  <h1 class="intro__role">{role}</h1>
  <p class="intro__thesis">
    {
      IS_PLACEHOLDER ? (
        <>
          <span class="intro__placeholder">[Placeholder]</span> {thesis}
        </>
      ) : (
        thesis
      )
    }
  </p>
  <p class="intro__pillars" lang="en">
    {
      PILLARS.map((pillar, i) => (
        <>
          {i > 0 && <span class="intro__sep" aria-hidden="true"> · </span>}
          <a href={pillar.href}>{pillar.name}</a>
        </>
      ))
    }
  </p>
</section>

<style>
  .intro {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-7) var(--space-6);
  }

  .intro__role {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 1.4rem + 1.2vw, 2.25rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .intro__thesis {
    color: var(--ink-soft);
    font-size: 1.125rem;
    line-height: 1.5;
    max-width: 40rem;
  }

  .intro__placeholder {
    margin-right: var(--space-2);
    color: var(--ink);
    font-weight: 600;
  }

  .intro__pillars {
    color: var(--ink-soft);
    font-size: 0.9375rem;
  }

  .intro__pillars a {
    color: var(--forest);
    text-decoration: none;
  }

  .intro__pillars a:hover {
    text-decoration: underline;
  }
</style>
