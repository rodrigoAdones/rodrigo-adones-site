---
// TODO(ADR 0007): set to the newsletter provider's plain-POST endpoint once one is chosen.
// While empty, the form renders disabled so nothing posts to a dead URL.
const NEWSLETTER_ACTION = '';
const isOpen = NEWSLETTER_ACTION !== '';
---

<section class="subscribe" aria-labelledby="subscribe-heading">
  <div class="subscribe__lead">
    <h2 id="subscribe-heading">Get each post by email</h2>
    <p>
      Every new post arrives in full, not as a teaser, in whichever language it was written.
    </p>
  </div>

  <form class="subscribe__form" action={isOpen ? NEWSLETTER_ACTION : undefined} method="post">
    <fieldset disabled={!isOpen}>
      <legend class="visually-hidden">Newsletter subscription</legend>
      <label for="subscribe-email">Email address</label>
      <div class="subscribe__row">
        <input
          id="subscribe-email"
          name="email"
          type="email"
          autocomplete="email"
          required
          placeholder="you@company.com"
          aria-describedby={isOpen ? undefined : 'subscribe-status'}
        />
        <button type="submit">Subscribe</button>
      </div>
      {
        !isOpen && (
          <p id="subscribe-status" class="subscribe__status">
            Subscriptions open when the first posts go live.
          </p>
        )
      }
    </fieldset>
  </form>
</section>

<style>
  .subscribe {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    background: var(--paper);
    border: 1px solid var(--holder-dark);
    box-shadow: 0 1px 0 var(--holder-dark);
  }

  .subscribe__lead {
    display: grid;
    align-content: center;
    gap: var(--space-2);
    padding: var(--space-5);
  }

  .subscribe__lead h2 {
    font-size: 1.375rem;
    line-height: 1.2;
  }

  .subscribe__lead p {
    color: var(--ink-soft);
    max-width: 44ch;
  }

  .subscribe__form {
    display: grid;
    align-content: center;
    padding: var(--space-5);
    border-left: 1px solid var(--rule);
  }

  fieldset {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .subscribe__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
  }

  input {
    min-width: 0;
    padding: var(--space-3);
    background: var(--board);
    border: 1px solid var(--holder-dark);
    border-right: 0;
    border-radius: 0;
    color: var(--ink);
    font: inherit;
    font-family: var(--font-mono);
    font-size: 1rem;
  }

  input::placeholder {
    color: #59625c;
    font-family: var(--font-sans);
  }

  input:focus-visible {
    outline-offset: 0;
    background: var(--paper);
  }

  button {
    padding: var(--space-3) var(--space-5);
    background: var(--ink);
    color: var(--paper);
    border: 1px solid var(--ink);
    border-radius: 0;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 200ms var(--ease-out);
  }

  button:hover {
    background: var(--pencil);
    border-color: var(--pencil);
  }

  fieldset:disabled input,
  fieldset:disabled button {
    cursor: not-allowed;
  }

  fieldset:disabled button {
    background: var(--holder);
    border-color: var(--holder);
    color: var(--ink);
  }

  fieldset:disabled input {
    background: var(--board-deep);
  }

  .subscribe__status {
    color: var(--ink-soft);
    font-size: 0.875rem;
  }

  @media (max-width: 48rem) {
    .subscribe {
      grid-template-columns: 1fr;
    }

    .subscribe__lead,
    .subscribe__form {
      padding: var(--space-4);
    }

    .subscribe__form {
      border-left: 0;
      border-top: 1px solid var(--rule);
    }
  }
</style>
