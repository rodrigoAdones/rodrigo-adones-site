---
import {
  LANG_NAMES,
  PILLARS,
  formatEntryDate,
  formatShortDate,
  type Entry,
} from '../lib/home';

interface Props {
  entry: Entry;
  /** Sample entries render unlinked: their post pages do not exist. */
  linked?: boolean;
}

const { entry, linked = true } = Astro.props;
const pillar = PILLARS.find((p) => p.id === entry.pillar);
const langName = LANG_NAMES[entry.lang];
---

<article class="entry">
  <div class="entry__meta">
    <time datetime={entry.pubDate.toISOString()}>{formatEntryDate(entry.pubDate)}</time>
    <p class="entry__meta-row">
      <span class="entry__lang">
        <span class="visually-hidden">{langName}</span>
        <span aria-hidden="true">{entry.lang.toUpperCase()}</span>
      </span>
      <span aria-hidden="true"> · </span>
      <span>{entry.readingMinutes} min</span>
    </p>
    {
      entry.updated && entry.updatedDate && (
        <p class="entry__updated">
          Updated <time datetime={entry.updatedDate.toISOString()}>{formatShortDate(entry.updatedDate)}</time>
        </p>
      )
    }
  </div>

  <div class="entry__body">
    <h3 class="entry__title" lang={entry.lang}>
      {linked ? <a href={entry.href}>{entry.title}</a> : entry.title}
    </h3>
    <p class="entry__desc" lang={entry.lang}>{entry.description}</p>
    {
      pillar && (
        <p class="entry__pillar">
          <a href={pillar.href}>{pillar.name}</a>
        </p>
      )
    }
  </div>
</article>

<style>
  .entry {
    display: grid;
    grid-template-columns: var(--date-col) minmax(0, 1fr);
    gap: var(--space-4) var(--space-5);
    padding-block: var(--space-5);
  }

  .entry__meta {
    display: grid;
    align-content: start;
    gap: var(--space-1);
    color: var(--ink-soft);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }

  .entry__meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
  }

  .entry__lang {
    font-weight: 500;
  }

  .entry__updated {
    font-style: italic;
  }

  .entry__body {
    display: grid;
    gap: var(--space-2);
  }

  .entry__title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.015em;
  }

  .entry__title a {
    color: var(--ink);
    text-decoration: none;
  }

  .entry__title a:hover {
    color: var(--forest);
    text-decoration: underline;
  }

  .entry__desc {
    color: var(--ink-soft);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .entry__pillar a {
    color: var(--forest);
    font-size: 0.875rem;
    text-decoration: none;
  }

  .entry__pillar a:hover {
    text-decoration: underline;
  }

  @media (max-width: 40rem) {
    .entry {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }

    .entry__meta {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: var(--space-1) var(--space-3);
    }
  }
</style>
