---
interface Props {
  current?: 'home' | 'blog' | 'about';
}

const { current = 'home' } = Astro.props;

const links = [
  { id: 'home', href: '/', label: 'Home' },
  { id: 'blog', href: '/blog/', label: 'Articles' },
  { id: 'about', href: '/about/', label: 'About' },
] as const;
---

<header class="rail" lang="en">
  <a class="rail__site" href="/">
    <span class="rail__monogram" aria-hidden="true">RA</span>
    <span class="rail__domain">rodrigoadones.dev</span>
  </a>

  <nav class="rail__nav" aria-label="Main">
    <ul>
      {
        links.map((link) => (
          <li>
            <a
              class="rail__tab"
              href={link.href}
              aria-current={current === link.id ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <p class="rail__note">Posts in English&nbsp;&amp;&nbsp;Español</p>
</header>

<style>
  .rail {
    position: sticky;
    top: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
    height: 100vh;
    height: 100dvh;
    padding: var(--space-5) var(--space-4) var(--space-5) var(--space-5);
    background: var(--board-deep);
    border-right: 2px solid var(--holder);
  }

  .rail__site {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
    text-decoration: none;
  }

  .rail__monogram {
    display: grid;
    place-items: center;
    width: 3rem;
    aspect-ratio: 1;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1.125rem;
    letter-spacing: 0.02em;
  }

  .rail__domain {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--ink-soft);
  }

  .rail__nav ul {
    display: grid;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  /* Each tab is a blank strip; the current one is pulled out onto the board. */
  .rail__tab {
    display: block;
    padding: var(--space-3) var(--space-4);
    background: var(--board);
    border: 1px solid var(--holder);
    font-weight: 700;
    font-size: 1.0625rem;
    text-decoration: none;
    transition:
      transform 260ms var(--ease-out),
      background-color 260ms var(--ease-out);
  }

  .rail__tab:hover {
    transform: translateX(0.375rem);
    background: var(--paper);
  }

  .rail__tab[aria-current='page'] {
    background: var(--paper);
    border-color: var(--ink);
    transform: translateX(0.75rem);
    box-shadow:
      inset 0 -3px 0 var(--pencil),
      var(--lift);
  }

  .rail__note {
    margin-top: auto;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--ink-soft);
  }

  @media (max-width: 60rem) {
    .rail {
      position: static;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
      height: auto;
      padding: var(--space-3) var(--space-4);
      border-right: 0;
      border-bottom: 2px solid var(--holder);
    }

    .rail__site {
      grid-auto-flow: column;
      align-items: center;
    }

    .rail__monogram {
      width: 2.5rem;
      font-size: 1rem;
    }

    .rail__domain,
    .rail__note {
      display: none;
    }

    .rail__nav ul {
      grid-auto-flow: column;
    }

    .rail__tab {
      padding: var(--space-2) var(--space-3);
      font-size: 0.9375rem;
    }

    .rail__tab:hover {
      transform: translateY(0.1875rem);
    }

    .rail__tab[aria-current='page'] {
      transform: translateY(0.375rem);
    }
  }
</style>
